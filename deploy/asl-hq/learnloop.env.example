# DRAFT contract. Most hosted fields are NOT implemented in local 0.3.
# Never copy real credential/account values back into Git.
NODE_ENV=production
LEARNLOOP_AUTH_MODE=google
LEARNLOOP_PUBLIC_ORIGIN=https://learn.allstreetlabs.com
LEARNLOOP_PORT=8830
LEARNLOOP_DATA_DIR=/var/lib/learnloop
GOOGLE_REDIRECT_URI=https://learn.allstreetlabs.com/auth/google/callback
