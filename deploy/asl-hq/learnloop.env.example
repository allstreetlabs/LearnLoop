# Hosted 0.4 contract. Deployment/provider changes still require approval.
# Never copy real credential/account values back into Git.
NODE_ENV=production
LEARNLOOP_AUTH_MODE=google
LEARNLOOP_PUBLIC_ORIGIN=https://learn.allstreetlabs.com
LEARNLOOP_PORT=8830
LEARNLOOP_DATA_DIR=/var/lib/learnloop
GOOGLE_REDIRECT_URI=https://learn.allstreetlabs.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# JSON allowlist: one sub OR email plus an existing ownerId per invitation.
# Empty fails startup. Supply real account details privately, not in Git.
# First email enrollment requires Gmail or Google Workspace; subject bindings
# persist immutably. Third-party Google email accounts need explicit sub pinning.
LEARNLOOP_GOOGLE_ACCOUNTS=[]

